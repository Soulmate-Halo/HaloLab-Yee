+static std::string kad_lower_trim(std::string s);
+static std::string kad_env(const char * name, const std::string & def);
+
+bool common_kad_env_enabled() {
+    const std::string v = kad_lower_trim(kad_env("YEE_KAD", ""));
+    return v == "1" || v == "true" || v == "yes" || v == "on";
+}
