+// ------------------------------------------------------------------------------------------------ helpers
+static std::string kad_env(const char * name, const std::string & def = "") {
+    const char * v = std::getenv(name);
+    if (v == nullptr) {
+        return def;
+    }
+    std::string s(v);
+    s.erase(0, s.find_first_not_of(" \t\r\n"));
+    s.erase(s.find_last_not_of(" \t\r\n") + 1);
+    return s.empty() ? def : s;
+}
+
+static double kad_env_double(const char * name, double def) {
+    const std::string s = kad_env(name);
+    if (s.empty()) {
+        return def;
+    }
+    try {
+        return std::stod(s);
+    } catch (...) {
+        return def;
+    }
+}
+
+static std::string kad_lower_trim(std::string s) {
+    s.erase(0, s.find_first_not_of(" \t\r\n"));
+    s.erase(s.find_last_not_of(" \t\r\n") + 1);
+    std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return (char) std::tolower(c); });
+    return s;
+}
+
+static std::string kad_home() {
+    std::string h = kad_env("HOME");
+    if (h.empty()) {
+        h = kad_env("USERPROFILE", ".");
+    }
+    return h;
+}
+
+static std::string kad_dir() {
+    std::string d = kad_env("YEE_KAD_DIR");
+    if (d.empty()) {
+        d = kad_home() + "/.cache/yee/kad";
+    } else if (d.size() >= 2 && d[0] == '~' && (d[1] == '/' || d[1] == '\\')) {
+        d = kad_home() + d.substr(1);
+    }
+    return d;
+}
+
+static double kad_now() {
+    using namespace std::chrono;
+    return duration<double>(steady_clock::now().time_since_epoch()).count();
+}
