diff --git a/src/models/qwen35.cpp b/src/models/qwen35.cpp
index 309dd43..daf80e6 100644
--- a/src/models/qwen35.cpp
+++ b/src/models/qwen35.cpp
@@ -1,6 +1,28 @@
 #include "models.h"
 #include "llama-memory-recurrent.h"
 
+#include <cstdio>
+#include <cstdlib>
+
+// Yee (llama.cpp-mtp-vocab): YEE_MTP_VOCAB_N=N makes the MTP draft head compute logits only for
+// token ids [0, N). Unset, 0 or N >= n_vocab keeps the original full head.
+static int64_t yee_mtp_vocab_n(int64_t n_vocab) {
+    static const long long v = [] {
+        const char * s = getenv("YEE_MTP_VOCAB_N");
+        return s ? strtoll(s, nullptr, 10) : 0LL;
+    }();
+    if (v <= 0 || v >= n_vocab) {
+        return 0;
+    }
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        fprintf(stderr, "[yee-mtp-vocab] MTP draft head limited to first %lld of %lld tokens\n",
+                (long long) v, (long long) n_vocab);
+    }
+    return (int64_t) v;
+}
+
 void llama_model_qwen35::load_arch_hparams(llama_model_loader & ml) {
     ml.get_key(LLM_KV_ATTENTION_LAYERNORM_RMS_EPS,       hparams.f_norm_rms_eps);
     ml.get_key_or_arr(LLM_KV_ROPE_DIMENSION_SECTIONS,    hparams.rope_sections, 4, true);
@@ -637,7 +659,23 @@ llama_model_qwen35::graph_mtp::graph_mtp(const llama_model & model, const llm_gr
     ggml_tensor * head_w = layer.nextn.shared_head_head ? layer.nextn.shared_head_head : model.output;
     ggml_tensor * head_s = layer.nextn.shared_head_head ? layer.nextn.shared_head_head_s : model.output_s;
     GGML_ASSERT(head_w && "QWEN35 MTP: missing LM head (nextn.shared_head_head or model.output)");
+
+    // Yee (llama.cpp-mtp-vocab): read only the first N rows of the head, then pad the logits back to
+    // n_vocab with -1000 so host-side buffers, copies and samplers keep their usual width.
+    const int64_t yee_n_vocab = head_w->ne[1];
+    int64_t       yee_vocab_n = yee_mtp_vocab_n(yee_n_vocab);
+    if (yee_vocab_n > 0 && head_s && ggml_nelements(head_s) > 1) {
+        yee_vocab_n = 0; // per-row head scales: keep the full head
+    }
+    if (yee_vocab_n > 0) {
+        head_w = ggml_view_2d(ctx0, head_w, head_w->ne[0], yee_vocab_n, head_w->nb[1], 0);
+    }
     cur = build_lora_mm(head_w, cur, head_s);
+    if (yee_vocab_n > 0) {
+        cur = ggml_scale_bias(ctx0, cur, 1.0f, 1000.0f);
+        cur = ggml_pad(ctx0, cur, (int) (yee_n_vocab - yee_vocab_n), 0, 0, 0);
+        cur = ggml_scale_bias(ctx0, cur, 1.0f, -1000.0f);
+    }
     cb(cur, "result_output", -1);
 
     res->t_logits = cur;
