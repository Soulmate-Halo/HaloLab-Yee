+class common_recall {
+public:
+    explicit common_recall(const common_recall_config & cfg);
+    ~common_recall();                       // flushes pending writes and joins the background thread
+
+    bool ok() const;                        // false: construction failed (logged); then every call is a no-op
+    const std::string & backend() const;    // "memory" | "disk"
+    const std::string & dir() const;        // resolved record directory ("" for memory)
+    bool read_only() const;
+    int  gamma() const;
+
+    // one stream per server slot
+    void begin_stream(int slot, const llama_token * prompt, size_t n_prompt, size_t cached_len);
+    void extend_stream(int slot, const llama_token * toks, size_t n);
+    void end_stream(int slot, bool finished);
+    bool has_stream(int slot) const;
+
+    // proposal for the current end of the slot's stream, at most n tokens (n is clamped to gamma);
+    // head_ema < 0: no draft head (recall only); >= 0: the head's own expected landed tokens per round
+    common_recall_proposal propose(int slot, int n, double head_ema);
+    // after the target verified a proposal: landed = accepted proposal tokens (bonus excluded)
+    void feedback(int slot, int landed, bool used);
+    // after the target verified a draft of the draft head: accepted draft tokens (yee.core observe_own);
+    // propose(..., head_ema < 0) compares the record with this per-slot average
+    void observe_own(int slot, int accepted);
+
+    void tick();                            // once per server loop
+    void clear();                           // drop every record (yee clear)
+    std::string stats_json();
+
+    // test hook: wait until every queued record write has been applied (the parity replay uses it)
+    void flush();
+
+private:
+    struct impl;
+    std::unique_ptr<impl> p_;
+};
