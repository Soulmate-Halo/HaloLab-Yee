+    // -------------------------------------------------------------- candidates (core.py:1933-2059)
+    bool own_candidate(const rec_stream & st, int n_tok, rec_cand & c) const {
+        const int64_t p = st.prev;
+        const int64_t n = (int64_t) st.ctx.size();
+        if (p < REC_WINDOW || p >= n) {
+            return false;
+        }
+        const int64_t * ctx = st.ctx.data();
+        for (int i = 0; i < REC_WINDOW; ++i) {
+            if (ctx[p - REC_WINDOW + i] != ctx[n - REC_WINDOW + i]) {
+                return false;
+            }
+        }
+        const int64_t back = std::min<int64_t>(REC_MAX_BACK - REC_WINDOW, p - REC_WINDOW);
+        int64_t ext = 0;
+        while (ext < back && ctx[p - REC_WINDOW - 1 - ext] == ctx[n - REC_WINDOW - 1 - ext]) {
+            ++ext;
+        }
+        const int L = REC_WINDOW + (int) ext;
+        if (L < min_match) {
+            return false;
+        }
+        const int64_t period = n - p;
+        c.toks.assign((size_t) n_tok, 0);
+        if (period >= n_tok) {
+            for (int j = 0; j < n_tok; ++j) {
+                c.toks[(size_t) j] = ctx[p + j];
+            }
+        } else {
+            for (int64_t j = 0; j < period; ++j) {
+                c.toks[(size_t) j] = ctx[p + j];
+            }
+            for (int64_t j = period; j < n_tok; ++j) {
+                c.toks[(size_t) j] = c.toks[(size_t) (j - period)];
+            }
+        }
+        c.src  = 0;
+        c.tier = rec_tier_of(L);
+        c.L    = L;
+        c.real = n_tok;
+        c.pos  = -1;
+        return true;
+    }
+
+    // continuation of a record hit as a candidate (shared by _record_candidate and candidates)
+    bool record_cont(int64_t p, int L, int n_tok, rec_cand & c) {
+        if (L >= REC_WINDOW && L < min_match) {
+            return false;
+        }
+        std::vector<int64_t> cont;
+        if (!rec->continuation(p, n_tok, std::min(min_n, n_tok), cont)) {
+            return false;
+        }
+        if (L < REC_WINDOW && (int) cont.size() > 2 * L) {
+            cont.resize((size_t) (2 * L));
+        }
+        const int real = (int) cont.size();
+        if (real < n_tok) {
+            cont.resize((size_t) n_tok, cont.back());
+        }
+        c.src  = 1;
+        c.tier = rec_tier_of(L);
+        c.L    = L;
+        c.toks = std::move(cont);
+        c.real = real;
+        c.pos  = p;
+        return true;
+    }
+
+    bool record_candidate(rec_stream & st, int n_tok, rec_cand & c) {
+        if (rec->end() - rec->base() < REC_WINDOW) {
+            return false;
+        }
+        lookups += 1;
+        const int64_t n  = (int64_t) st.ctx.size();
+        const int64_t t0 = std::max<int64_t>(0, n - REC_MAX_BACK);
+        int64_t p = 0;
+        int     L = 0;
+        if (!rec->lookup(st.ctx.data() + t0, n - t0, REC_MAX_BACK, &st.h, p, L)) {
+            return false;
+        }
+        return record_cont(p, L, n_tok, c);
+    }
