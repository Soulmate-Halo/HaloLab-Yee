+// ------------------------------------------------------------------------------------------------ public helpers
+bool common_recall_env_enabled() {
+    return rec_true(rec_env("on", "0")) || rec_true(rec_getenv("YEE_RECALL"));
+}
+
+void common_recall_config_from_env(common_recall_config & cfg) {
+    if (cfg.dir.empty()) {
+        cfg.dir = rec_env("dir", "");
+        if (cfg.dir.empty() && rec_lower(rec_env("backend", "")) == "disk") {
+            // explicit disk backend without a directory: the yee.core default ~/.cache/recall_accel/<digest[:16]>
+            const std::string digest = cfg.identity.empty() ? std::string("unknown") : cfg.identity;
+            cfg.dir = rec_home() + "/.cache/recall_accel/" + digest.substr(0, 16);
+        }
+    }
+    if (cfg.gib < 0) {
+        cfg.gib = rec_env_double("gib", 0.0625);
+    }
+    if (cfg.read_only < 0) {
+        cfg.read_only = rec_true(rec_env("read_only", "0")) ? 1 : 0;
+    }
+    if (cfg.min_match < 0) {
+        cfg.min_match = (int) rec_env_double("min_match", REC_WINDOW);
+    }
+    if (cfg.stats_file.empty()) {
+        cfg.stats_file = rec_getenv("YEE_RECALL_STATS_FILE");
+    }
+    if (cfg.log_s < 0) {
+        const std::string v = rec_getenv("YEE_RECALL_LOG_S");
+        try {
+            cfg.log_s = v.empty() ? 30.0 : std::stod(v);
+        } catch (...) {
+            cfg.log_s = 30.0;
+        }
+    }
+}
+
+// identity of a list of token pieces (common_recall_vocab_identity); declared here for the unit test
+std::string common_recall_identity_of(int32_t n_vocab, const std::vector<std::string> & pieces) {
+    std::string buf = "yee-recall-vocab-v1\nn_vocab=" + std::to_string(n_vocab) + "\n";
+    for (const auto & p : pieces) {
+        buf += std::to_string(p.size());
+        buf += ':';
+        buf += p;
+        buf += '\n';
+    }
+    return common_kad_sha256_hex(buf);
+}
+
+std::string common_recall_vocab_identity(const struct llama_vocab * vocab) {
+    if (vocab == nullptr) {
+        return "";
+    }
+    const int32_t n = llama_vocab_n_tokens(vocab);
+    std::vector<std::string> pieces;
+    pieces.reserve((size_t) std::max(0, n));
+    for (int32_t i = 0; i < n; ++i) {
+        const char * t = llama_vocab_get_text(vocab, i);
+        pieces.emplace_back(t ? t : "");
+    }
+    return common_recall_identity_of(n, pieces);
+}
