+// Yee Recall for llama-server: C++ port of yee.core RecallRecord (memory / disk backend, fifo eviction)
+// and RecallEngine (streams, own-context and record candidates, expectations, probes, feedback).
+// Rules, constants and tie-breaks follow yee/core.py line by line; see NOTES_core.md for the mapping.
+
+#include "recall.h"
+
+#include "kad.h"
+#include "log.h"
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
