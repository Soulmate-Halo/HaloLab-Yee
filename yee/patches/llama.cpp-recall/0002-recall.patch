+// ------------------------------------------------------------------------------------------------ engine parts (core.py:1693-1756)
+struct rec_stat {
+    double  n      = 0.0;
+    double  s      = 0.0;
+    int64_t offers = 0;
+    int64_t landed = 0;
+};
+
+struct rec_pending {
+    int     src;
+    int     tier;
+    bool    probe;
+    int     real;
+    double  own;
+    int64_t pos;
+};
+
+struct rec_stream {
+    std::vector<int64_t> ctx;
+    uint64_t h    = 0;
+    std::unordered_map<uint64_t, int64_t> own;
+    int64_t prev     = -1;
+    int     cooldown = 0;
+    std::deque<rec_pending> pending;
+    double  own_ema = 0.0;
+    std::vector<int64_t> prompt_tail;
+    int64_t offers    = 0;
+    int64_t out_len   = 0;
+    double  last_seen = 0.0;
+
+    void append(const int64_t * toks, size_t m, uint64_t pw1) {
+        for (size_t i = 0; i < m; ++i) {
+            const int64_t t = toks[i];
+            ctx.push_back(t);
+            const size_t n = ctx.size();
+            if (n > (size_t) REC_WINDOW) {
+                h = rec_roll(h, ctx[n - REC_WINDOW - 1], t, pw1);
+            } else if (n == (size_t) REC_WINDOW) {
+                h = rec_hash(ctx.data(), REC_WINDOW);
+            } else {
+                continue;
+            }
+            auto it = own.find(h);
+            prev = it == own.end() ? -1 : it->second;
+            own[h] = (int64_t) n;
+        }
+    }
+};
+
+struct rec_cand {
+    int src  = 0; // 0 own, 1 record
+    int tier = 0;
+    int L    = 0;
+    std::vector<int64_t> toks;
+    int     real = 0;
+    int64_t pos  = -1;
+};
+
+struct rec_job {
+    int kind = 0; // 1 add, 2 clear, 3 stats
+    std::vector<int64_t> ids;
+    std::string text;
+};
