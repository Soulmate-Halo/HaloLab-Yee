+    int64_t append_segment(const int64_t * seg, size_t n) {
+        if (end() > base()) {
+            std::vector<int64_t> last;
+            if (store.read(end() - 1, end(), last) && last[0] != REC_SENTINEL) {
+                const int64_t s = REC_SENTINEL;
+                store.write(&s, 1);
+            }
