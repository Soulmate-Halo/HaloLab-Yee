+        if (lim > w) {
+            const int64_t g0 = std::max(base(), p - lim);
+            std::vector<int64_t> back;
+            if (store.read(g0, p - w, back) && !back.empty()) {
+                const int64_t bs = (int64_t) back.size();
+                int64_t j = 0;
+                while (j < bs && back[(size_t) (bs - 1 - j)] == t[n - w - 1 - j]) {
+                    ++j;
+                }
+                L += (int) j;
+            }
+        }
+        return L;
+    }
+
+    bool window_matches(const int64_t * t, int64_t n, int64_t p, int w) {
+        std::vector<int64_t> rec;
+        if (!store.read(p - w, p, rec)) {
+            return false;
+        }
+        for (int i = 0; i < w; ++i) {
+            if (rec[(size_t) i] != t[n - w + i]) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    bool cold_lookup(const int64_t * t, int64_t n, int max_back, uint64_t h, int64_t & p_out, int & L_out) {
+        if (end() - base() < REC_WINDOW) {
+            return false;
+        }
+        const size_t s = (size_t) (rec_mix(h) & (uint64_t) mask);
+        if (keys[s] != h) {
+            return false;
+        }
+        const int64_t p = pos[s];
+        if (p - REC_WINDOW < base() || p > end()) {
+            return false;
+        }
+        if (!window_matches(t, n, p, REC_WINDOW)) {
+            return false;
+        }
+        p_out = p;
+        L_out = back_extend(t, n, p, REC_WINDOW, max_back);
+        return true;
+    }
+
+    bool short_hit(const short_tab & tab, const int64_t * t, int64_t n, int max_back, int64_t & p_out, int & L_out) {
+        const int w = tab.w;
+        if (n < w) {
+            return false;
+        }
+        const uint64_t hw = rec_hash(t + n - w, w);
+        const size_t   s  = (size_t) (rec_mix(hw) & (uint64_t) smask);
+        if (tab.k[s] != hw) {
+            return false;
+        }
+        const int64_t p = tab.p[s];
+        if (p - w < base() || p > end()) {
+            return false;
+        }
+        if (!window_matches(t, n, p, w)) {
+            return false;
+        }
+        p_out = p;
+        L_out = back_extend(t, n, p, w, max_back);
+        return true;
+    }
+
+    bool short_lookup(const int64_t * t, int64_t n, int max_back, int64_t & p_out, int & L_out) {
+        if (end() - base() < REC_WINDOW) {
+            return false;
+        }
+        for (const auto & tab : shorts) {
+            if (short_hit(tab, t, n, max_back, p_out, L_out)) {
+                short_hits += 1;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    bool lookup(const int64_t * t, int64_t n, int max_back, const uint64_t * h, int64_t & p_out, int & L_out) {
+        bool hit = false;
+        if (n >= REC_WINDOW) {
+            const uint64_t hh = h ? *h : rec_hash(t + n - REC_WINDOW, REC_WINDOW);
+            hit = cold_lookup(t, n, max_back, hh, p_out, L_out);
+        }
+        if (!hit && !shorts.empty()) {
+            hit = short_lookup(t, n, max_back, p_out, L_out);
+        }
+        return hit;
+    }
+
+    // every distinct hit (long window, then each short window), sorted by match length, stable
+    void lookup_all(const int64_t * t, int64_t n, int max_back, const uint64_t * h, std::vector<std::pair<int64_t, int>> & out) {
+        out.clear();
+        auto add = [&](int64_t p, int L) {
+            for (const auto & o : out) {
+                if (o.first == p) {
+                    return;
+                }
+            }
+            out.emplace_back(p, L);
+        };
+        int64_t p = 0;
+        int     L = 0;
+        if (n >= REC_WINDOW) {
+            const uint64_t hh = h ? *h : rec_hash(t + n - REC_WINDOW, REC_WINDOW);
+            if (cold_lookup(t, n, max_back, hh, p, L)) {
+                add(p, L);
+            }
+        }
+        if (!shorts.empty() && end() - base() >= REC_WINDOW) {
+            for (const auto & tab : shorts) {
+                if (short_hit(tab, t, n, max_back, p, L)) {
+                    add(p, L);
+                }
+            }
+        }
+        std::stable_sort(out.begin(), out.end(), [](const std::pair<int64_t, int> & x, const std::pair<int64_t, int> & y) { return x.second > y.second; });
+    }
+
+    // at most n ids after pos (at least min_n), cut at a sentinel
+    bool continuation(int64_t p, int n, int min_n, std::vector<int64_t> & seg) {
+        const int64_t e = std::min<int64_t>(p + n, end());
+        if (e - p < min_n) {
+            return false;
+        }
+        if (!store.read(p, e, seg)) {
+            return false;
+        }
+        for (size_t i = 0; i < seg.size(); ++i) {
+            if (seg[i] < 0) {
+                seg.resize(i);
+                break;
+            }
+        }
+        return (int) seg.size() >= min_n;
+    }
+
+    // core.py:1508-1526; returns "" or an error text (python raises)
+    std::string clear() {
+        if (!writer) {
+            return "PermissionError: recall record " + (dir.empty() ? backend : dir) + " is read-only here";
+        }
+        const std::vector<std::string> failed = store.clear();
+        std::fill(keys.begin(), keys.end(), 0);
+        std::fill(pos.begin(), pos.end(), -1);
+        for (auto & tab : shorts) {
+            std::fill(tab.k.begin(), tab.k.end(), 0);
+            std::fill(tab.p.begin(), tab.p.end(), -1);
+        }
+        added_ids = deduped_ids = adds = evicted_chunks = 0;
+        skipped_low_disk = 0;
+        if (!failed.empty()) {
+            add_blocked = true;
+            std::string names;
+            for (const auto & f : failed) {
+                names += (names.empty() ? "" : ", ") + f;
+            }
+            last_error = "could not delete " + names;
+            return "OSError: " + last_error;
+        }
+        add_blocked = false;
+        last_error.clear();
+        return "";
+    }
+
+    bool poll_clear_request() {
+        bool req = clear_requested;
+        clear_requested = false;
+        if (!dir.empty()) {
