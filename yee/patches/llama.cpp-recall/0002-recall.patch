+            return 0;
+        }
+        std::vector<int64_t> a;
+        a.reserve(ids.size());
+        for (int64_t x : ids) {
+            if (x >= 0) {
+                a.push_back(x);
+            }
+        }
+        if ((int64_t) a.size() < REC_WINDOW) {
+            return 0;
+        }
+        if (backend == "disk" && !dir.empty()) {
+            std::error_code ec;
+            const fs::space_info sp = fs::space(dir, ec);
+            if (!ec && (double) sp.free < min_free_bytes) {
+                skipped_low_disk += 1;
+                return 0;
+            }
+        }
+        const std::vector<char> keep = novel_mask(a);
+        int64_t added = 0;
+        for (const auto & ij : rec_segments(keep, REC_OVERLAP)) {
+            if (ij.second - ij.first >= REC_WINDOW) {
+                added += append_segment(a.data() + ij.first, (size_t) (ij.second - ij.first));
+            }
+        }
+        const int64_t kept = (int64_t) std::count_if(keep.begin(), keep.end(), [](char v) { return v != 0; });
+        deduped_ids += (int64_t) a.size() - kept;
+        if (added) {
+            store.flush();
+            evict();
+        }
+        added_ids += added;
+        adds += 1;
+        return added;
+    }
