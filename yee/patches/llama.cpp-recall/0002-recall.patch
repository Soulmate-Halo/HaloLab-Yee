+    int    gamma           = 12;
+    int    min_match       = REC_WINDOW;
+    int    cooldown_rounds = 4;
+    int    probe_start     = 16;
+    int    probe_max       = 4096;
+    double prior           = 0.8 * 12;
+    double prior_w         = 2.0;
+    double decay           = 0.98;
+    int    min_n           = 2;
+    double own_alpha       = 0.25;
+    bool   tree            = true;  // YEE_TREE (default on): propose_select over every distinct candidate
+    int    tree_k          = 4;     // max(1, YEE_TREE_K (2)) + 2
+    bool   sync            = false; // YEE_RECALL_SYNC=1: record writes run on the caller thread
+
+    bool        ok_ = false;
+    std::string backend_ = "memory";
+    std::string dir_;
+    bool        read_only_ = false;
+    std::string stats_file_;
+    double      log_s_ = 30.0;
+    std::string tag_   = "[yee-recall] llama.cpp";
+
+    std::unique_ptr<rec_record> rec;
+    uint64_t pw1 = rec_pow_p(REC_WINDOW - 1);
+
+    // engine state (guarded by mu); the record is guarded by rmu (lock order: mu, then rmu)
+    mutable std::mutex mu;
+    std::mutex         rmu;
+    std::map<int, rec_stream> streams;
+    rec_stat stats[2][4];
+    int      probe_iv[2]   = { 16, 16 };
+    int      probe_left[2] = { 16, 16 };
+    double   own_global    = 6.0;
+    int64_t  offers = 0, probes = 0, tree_selects = 0, landed_tokens = 0, unused = 0, lookups = 0, rounds_own = 0;
+    int64_t  streams_begun = 0, gc_streams = 0, used_n = 0, lock_skips = 0, ticks = 0;
+    int64_t  offers_src[2]  = { 0, 0 };
+    int64_t  offers_tier[4] = { 0, 0, 0, 0 };
+    std::string last_clear;
+    double   last_tick = -1e30;
+    double   last_log  = 0.0;
+    std::atomic<int64_t> errors{ 0 };
+    std::atomic<int>     err_printed{ 0 };
+
+    // background writer
+    std::thread             th;
+    std::mutex              qmu;
+    std::condition_variable qcv;
+    std::condition_variable qdone;
+    std::deque<rec_job>     q;
+    bool                    busy = false;
+    bool                    stop = false;
+
+    void error(const char * what, const std::string & msg) {
+        errors.fetch_add(1);
+        if (err_printed.fetch_add(1) < 5) {
+            LOG_WRN("%s %s failed (recall skips this call): %s\n", tag_.c_str(), what, msg.c_str());
+        }
+    }
+
+    double expect(int src, int tier) const {
+        const rec_stat & s = stats[src][tier];
+        const double pr = prior * (tier == REC_SHORT_TIER ? 0.5 : 1.0);
+        return (s.s + pr * prior_w) / (s.n + prior_w);
+    }
+
+    // -------------------------------------------------------------- writer
+    void run_job(rec_job & job) {
+        try {
+            if (job.kind == 1) {
+                std::lock_guard<std::mutex> lk(rmu);
+                rec->add(job.ids);
+            } else if (job.kind == 2) {
+                do_clear();
+            } else if (job.kind == 3) {
+                write_stats(job.text);
+            }
+        } catch (const std::exception & e) {
+            std::lock_guard<std::mutex> lk(rmu);
+            rec->last_error = e.what();
+            error("record write", e.what());
+        }
+    }
+
+    void writer_loop() {
+        for (;;) {
+            rec_job job;
+            {
+                std::unique_lock<std::mutex> lk(qmu);
+                qcv.wait(lk, [&] { return stop || !q.empty(); });
+                if (q.empty()) {
+                    return;
+                }
+                job = std::move(q.front());
+                q.pop_front();
+                busy = true;
+            }
+            run_job(job);
+            {
+                std::lock_guard<std::mutex> lk(qmu);
+                busy = false;
+            }
+            qdone.notify_all();
+        }
+    }
+
+    void submit(rec_job && job) {
+        if (sync || !th.joinable()) {
+            run_job(job);
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lk(qmu);
+            q.push_back(std::move(job));
+        }
+        qcv.notify_one();
+    }
+
+    void flush() {
+        if (sync || !th.joinable()) {
+            return;
+        }
+        std::unique_lock<std::mutex> lk(qmu);
+        qdone.wait_for(lk, std::chrono::seconds(30), [&] { return q.empty() && !busy; });
+    }
+
+    void do_clear() {
+        std::lock_guard<std::mutex> lk(mu);
+        std::lock_guard<std::mutex> lr(rmu);
+        const std::string err = rec->clear();
+        if (!err.empty()) {
+            last_clear = "error " + err;
+            return;
+        }
+        for (auto & row : stats) {
+            for (auto & s : row) {
+                s = rec_stat();
+            }
+        }
+        offers = probes = landed_tokens = unused = lookups = 0;
+        last_clear = "ok " + rec_utc_stamp();
+    }
+
+    void write_stats(const std::string & text) {
+        if (stats_file_.empty()) {
+            return;
+        }
+        std::error_code ec;
+        const fs::path p(stats_file_);
+        if (p.has_parent_path()) {
+            fs::create_directories(p.parent_path(), ec);
+        }
+        const std::string tmp = stats_file_ + ".tmp";
+        {
+            std::ofstream f(tmp, std::ios::binary | std::ios::trunc);
+            f << text;
+            if (!f.good()) {
+                throw std::runtime_error("cannot write " + tmp);
+            }
+        }
+        fs::rename(tmp, stats_file_, ec);
+        if (ec) {
+            throw std::runtime_error("cannot rename " + tmp + ": " + ec.message());
+        }
+    }
