+#include <map>
+#include <mutex>
+#include <sstream>
+#include <stdexcept>
+#include <thread>
+#include <unordered_map>
+#include <utility>
+
+#if !defined(_WIN32)
+#include <fcntl.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+using json = nlohmann::json;
+namespace fs = std::filesystem;
+
+namespace {
+
+// ------------------------------------------------------------------------------------------------ constants (core.py:56-90)
+constexpr int64_t  REC_CHUNK_IDS  = 1 << 20;
+constexpr int64_t  REC_SENTINEL   = -1;
+constexpr int      REC_WINDOW     = 16;
+constexpr int      REC_DEDUP_RUN  = 128;
+constexpr int      REC_OVERLAP    = 32;
+constexpr int      REC_MAX_BACK   = 128;
+constexpr int      REC_MIN_TAIL   = 4;
+constexpr int      REC_SHORT_TIER = 3;
+constexpr double   REC_DEFAULT_INDEX_DENSITY = 0.25;
+constexpr double   REC_MIN_INDEX_DENSITY     = 1.0 / 64.0;
+constexpr double   REC_MAX_INDEX_DENSITY     = 4.0;
+constexpr uint64_t REC_P  = 0x9E3779B97F4A7C15ULL;
+constexpr uint64_t REC_M1 = 0xBF58476D1CE4E5B9ULL;
+
+const char * const REC_TIER_NAMES[4] = { "16-31", "32-63", "64+", "<16" };
+const char * const REC_SRC_NAMES[2]  = { "own", "record" };
+
+uint64_t rec_pow_p(int e) {
+    uint64_t r = 1;
+    for (int i = 0; i < e; ++i) {
+        r *= REC_P;
+    }
+    return r;
+}
+
+// polynomial window hash, uint64 wrap-around == python "& MASK64" (core.py:195-199)
+inline uint64_t rec_hash(const int64_t * t, int w) {
+    uint64_t h = 0;
+    for (int i = 0; i < w; ++i) {
+        h = h * REC_P + (uint64_t) (t[i] + 1);
+    }
+    return h;
+}
+
+// rolling update of a window hash of width w (pw1 = P^(w-1)); WINDOW: core.py:202-203 _roll_int
+inline uint64_t rec_roll(uint64_t h, int64_t out, int64_t in, uint64_t pw1) {
+    return (h - (uint64_t) (out + 1) * pw1) * REC_P + (uint64_t) (in + 1);
+}
+
+inline uint64_t rec_mix(uint64_t h) {
+    h ^= h >> 31;
+    h *= REC_M1;
+    h ^= h >> 27;
+    return h;
+}
+
+inline int rec_tier_of(int L) {
+    if (L < REC_WINDOW) {
+        return REC_SHORT_TIER;
+    }
+    if (L >= 64) {
+        return 2;
+    }
+    if (L >= 32) {
+        return 1;
+    }
+    return 0;
+}
+
+double rec_now() {
+    using namespace std::chrono;
+    return duration<double>(steady_clock::now().time_since_epoch()).count();
+}
+
+std::string rec_utc_stamp() {
+    const std::time_t t = std::time(nullptr);
+    std::tm tm{};
+#if defined(_WIN32)
+    gmtime_s(&tm, &t);
+#else
+    gmtime_r(&t, &tm);
+#endif
+    char buf[32];
+    std::strftime(buf, sizeof(buf), "%Y-%m-%dT%H:%M:%SZ", &tm);
+    return buf;
+}
+
+// ------------------------------------------------------------------------------------------------ environment (core.py:93-184)
+std::string rec_trim(std::string s) {
+    s.erase(0, s.find_first_not_of(" \t\r\n"));
+    s.erase(s.find_last_not_of(" \t\r\n") + 1);
+    return s;
+}
+
+std::string rec_lower(std::string s) {
+    std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return (char) std::tolower(c); });
+    return s;
+}
+
+bool rec_true(const std::string & v) {
+    const std::string s = rec_lower(rec_trim(v));
+    return s == "1" || s == "true" || s == "yes" || s == "on";
+}
+
+std::string rec_getenv(const std::string & name) {
+    if (name.empty()) {
+        return "";
+    }
+    const char * v = std::getenv(name.c_str());
+    return v ? rec_trim(v) : std::string();
+}
+
+struct rec_env_names {
+    const char * key;
+    const char * now;    // ENV_NEW
+    const char * old;    // ENV_OLD
+    const char * older;  // ENV_OLDER
+};
+
+const rec_env_names REC_ENV[] = {
+    { "on",            "RECALL_ACCEL",               "SGLANG_D_RECALL",               "DSV41_RECALL"              },
+    { "dir",           "RECALL_ACCEL_DIR",           "SGLANG_D_RECALL_DIR",           "DSV41_RECALL_DIR"          },
+    { "gib",           "RECALL_ACCEL_GIB",           "SGLANG_D_RECALL_GIB",           "DSV41_RECALL_GIB"          },
+    { "backend",       "RECALL_ACCEL_BACKEND",       "SGLANG_D_RECALL_BACKEND",       "RECALL_BACKEND"            },
+    { "min_match",     "RECALL_ACCEL_MIN_MATCH",     "SGLANG_D_RECALL_MIN_MATCH",     "DSV41_RECALL_MIN_MATCH"    },
+    { "prior",         "RECALL_ACCEL_PRIOR",         "SGLANG_D_RECALL_PRIOR",         "DSV41_RECALL_PRIOR"        },
+    { "read_only",     "RECALL_ACCEL_READ_ONLY",     "SGLANG_D_RECALL_READ_ONLY",     "DSV41_RECALL_READ_ONLY"    },
+    { "min_free_gib",  "RECALL_ACCEL_MIN_FREE_GIB",  "SGLANG_D_RECALL_MIN_FREE_GIB",  "DSV41_RECALL_MIN_FREE_GIB" },
+    { "evict",         "RECALL_ACCEL_EVICT",         "SGLANG_D_RECALL_EVICT",         "RECALL_EVICT"              },
+    { "dedup_run",     "RECALL_ACCEL_DEDUP_RUN",     "SGLANG_D_RECALL_DEDUP_RUN",     "RECALL_DEDUP_RUN"          },
+    { "index_density", "RECALL_ACCEL_INDEX_DENSITY", "SGLANG_D_RECALL_INDEX_DENSITY", "RECALL_INDEX_DENSITY"      },
+};
+
+// yee.core _env after yee's alias (YEE_<X> -> RECALL_ACCEL_<X> when unset): RECALL_ACCEL_<X> -> YEE_<X> -> old name ->
+// VLLM_D_RECALL_* -> older name; blank values count as unset
+std::string rec_env(const char * key, const std::string & def) {
+    for (const auto & e : REC_ENV) {
+        if (std::strcmp(e.key, key) != 0) {
+            continue;
+        }
+        std::string vllm = e.now;
+        vllm.replace(0, std::strlen("RECALL_ACCEL"), "VLLM_D_RECALL");
+        const std::string yee = "YEE" + std::string(e.now).substr(std::strlen("RECALL_ACCEL"));
+        for (const std::string & n : { std::string(e.now), yee, std::string(e.old), vllm, std::string(e.older) }) {
+            const std::string v = rec_getenv(n);
+            if (!v.empty()) {
+                return v;
+            }
+        }
+        return def;
+    }
+    return def;
+}
+
+double rec_env_double(const char * key, double def) {
+    const std::string v = rec_env(key, "");
+    if (v.empty()) {
+        return def;
+    }
+    try {
+        return std::stod(v);
+    } catch (...) {
+        return def;
+    }
+}
+
+// yee.tree env_value: YEE_ -> RECALL_ACCEL_ -> SGLANG_D_RECALL_ -> VLLM_D_RECALL_
+std::string rec_tree_env(const char * suffix, const std::string & def) {
+    for (const char * pre : { "YEE_", "RECALL_ACCEL_", "SGLANG_D_RECALL_", "VLLM_D_RECALL_" }) {
+        const std::string v = rec_getenv(std::string(pre) + suffix);
+        if (!v.empty()) {
+            return v;
+        }
+    }
+    return def;
+}
+
+// SHORT_WINDOWS (core.py:239-253): RECALL_ACCEL_WINDOWS, default "16,8,4" -> (8, 4), descending
+std::vector<int> rec_short_windows() {
+    const char * raw = std::getenv("RECALL_ACCEL_WINDOWS");
+    const std::string s = raw ? std::string(raw) : std::string("16,8,4");
+    std::vector<int> out;
+    std::stringstream ss(s);
+    std::string x;
+    while (std::getline(ss, x, ',')) {
+        x = rec_trim(x);
+        if (x.empty() || x.size() > 4 || !std::all_of(x.begin(), x.end(), [](unsigned char c) { return std::isdigit(c) != 0; })) {
+            continue;
+        }
+        const int w = std::stoi(x);
+        if (w >= 4 && w < REC_WINDOW && std::find(out.begin(), out.end(), w) == out.end()) {
+            out.push_back(w);
+        }
+    }
+    std::sort(out.begin(), out.end(), std::greater<int>());
+    return out;
+}
+
+std::string rec_home() {
+    std::string h = rec_getenv("HOME");
+    if (h.empty()) {
+        h = rec_getenv("USERPROFILE");
+    }
+    return h.empty() ? std::string(".") : h;
+}
+
+std::string rec_expand(const std::string & p) {
+    if (p.size() >= 2 && p[0] == '~' && (p[1] == '/' || p[1] == '\\')) {
+        return rec_home() + p.substr(1);
+    }
+    if (p == "~") {
+        return rec_home();
+    }
+    return p;
+}
+
+struct rec_identity_error : std::runtime_error {
+    explicit rec_identity_error(const std::string & m) : std::runtime_error(m) {}
+};
+
+bool rec_write_private(const std::string & path, const std::string & text) {
+#if !defined(_WIN32)
+    const int fd = ::open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    if (fd < 0) {
+        return false;
+    }
+    const ssize_t n = ::write(fd, text.data(), text.size());
+    ::close(fd);
+    return n == (ssize_t) text.size();
+#else
+    std::ofstream f(path, std::ios::binary | std::ios::trunc);
+    f << text;
+    return f.good();
+#endif
+}
+
+bool rec_is_chunk_name(const std::string & name, int64_t & seq) {
+    // ^chunk-(\d{8})\.ids$
+    if (name.size() != 18 || name.compare(0, 6, "chunk-") != 0 || name.compare(14, 4, ".ids") != 0) {
+        return false;
+    }
+    int64_t v = 0;
+    for (int i = 6; i < 14; ++i) {
+        if (!std::isdigit((unsigned char) name[i])) {
+            return false;
+        }
+        v = v * 10 + (name[i] - '0');
+    }
+    seq = v;
+    return true;
+}
+
+// ------------------------------------------------------------------------------------------------ store (core.py:301-712)
+// One class for the memory and the disk backend: the disk backend keeps the same chunks in memory and appends every
+// write to chunk-%08d.ids (int32, little endian), like _DiskStore.
+struct rec_store {
+    int64_t C        = REC_CHUNK_IDS;
+    int64_t cap_ids  = REC_CHUNK_IDS;
+    int64_t base_pos = 0;
+    int64_t end_pos  = 0;
+    std::map<int64_t, std::vector<int32_t>> chunks;
+    std::map<int64_t, int64_t>              fill;
+    std::vector<std::pair<int64_t, int64_t>> ranges;
+
+    bool        disk      = false;
+    bool        read_only = false;
+    bool        writer    = true;
+    std::string dir;
+    json        identity_on_disk = json::object();
+    int64_t     load_evicted = 0;
+    std::string last_error;
+
+    FILE *  fh      = nullptr;
+    int64_t fh_seq  = -1;
+    int     lock_fd = -1;
+
+    ~rec_store() { close(); }
+
+    std::string chunk_path(int64_t seq) const {
+        char b[40];
+        std::snprintf(b, sizeof(b), "chunk-%08lld.ids", (long long) seq);
+        return dir + "/" + b;
+    }
+
+    // [g0, g1) as int64; false = out of range / evicted (python: None)
+    bool read(int64_t g0, int64_t g1, std::vector<int64_t> & out) const {
+        out.clear();
+        if (g0 < base_pos || g1 > end_pos || g0 > g1) {
+            return false;
+        }
+        out.resize((size_t) (g1 - g0));
+        int64_t pos = g0;
+        size_t  w   = 0;
+        while (pos < g1) {
+            const int64_t seq = pos / C;
+            const int64_t o   = pos - seq * C;
+            auto it = chunks.find(seq);
+            if (it == chunks.end()) {
+                out.clear();
+                return false;
+            }
+            const int64_t take = std::min(C - o, g1 - pos);
+            const int32_t * src = it->second.data() + o;
+            for (int64_t i = 0; i < take; ++i) {
+                out[w + (size_t) i] = src[i];
+            }
+            pos += take;
+            w += (size_t) take;
+        }
+        return true;
+    }
+
+    void open_file(int64_t seq) {
+        if (fh != nullptr) {
+            std::fclose(fh);
+            fh = nullptr;
+        }
+        fh_seq = -1;
+        const std::string path = chunk_path(seq);
+#if !defined(_WIN32)
+        const int fd = ::open(path.c_str(), O_WRONLY | O_CREAT | O_APPEND, 0600);
+        if (fd >= 0) {
+            fh = ::fdopen(fd, "ab");
+            if (fh == nullptr) {
+                ::close(fd);
+            }
+        }
+#else
+        fh = std::fopen(path.c_str(), "ab");
+#endif
+        if (fh == nullptr) {
+            throw std::runtime_error("cannot open " + path);
+        }
+        fh_seq = seq;
+    }
+
+    void write(const int64_t * a, size_t n) {
+        size_t off = 0;
+        while (off < n) {
+            const int64_t seq = end_pos / C;
+            const int64_t o   = end_pos - seq * C;
+            auto & buf = chunks[seq];
+            if (buf.empty()) {
+                buf.assign((size_t) C, (int32_t) REC_SENTINEL);
+                fill[seq] = 0;
+            }
+            if (disk && (fh == nullptr || fh_seq != seq)) {
+                open_file(seq);
+            }
+            const int64_t take = std::min<int64_t>(C - o, (int64_t) (n - off));
+            for (int64_t i = 0; i < take; ++i) {
+                buf[(size_t) (o + i)] = (int32_t) a[off + (size_t) i];
+            }
+            if (disk) {
+                // int32 little endian (x86 / arm hosts), the layout of yee.core _DiskStore
+                if (std::fwrite(buf.data() + o, sizeof(int32_t), (size_t) take, fh) != (size_t) take) {
+                    throw std::runtime_error("write failed: " + chunk_path(seq));
+                }
+            }
+            fill[seq] = o + take;
+            end_pos += take;
+            off += (size_t) take;
+        }
+    }
+
+    void flush() {
+        if (fh != nullptr) {
+            std::fflush(fh);
+        }
+    }
+
+    void drop_range(int64_t seq) {
+        ranges.erase(std::remove_if(ranges.begin(), ranges.end(), [&](const std::pair<int64_t, int64_t> & r) { return r.first / C == seq; }),
+                     ranges.end());
+    }
+
+    int64_t evict() {
+        int64_t evicted = 0;
+        while (end_pos - base_pos > cap_ids && chunks.size() > 1) {
+            const int64_t oldest = chunks.begin()->first;
+            base_pos = (oldest + 1) * C;
+            chunks.erase(oldest);
+            fill.erase(oldest);
+            drop_range(oldest);
+            if (disk) {
+                if (fh != nullptr && fh_seq == oldest) {
+                    std::fclose(fh);
+                    fh     = nullptr;
+                    fh_seq = -1;
+                }
+                std::error_code ec;
+                fs::remove(chunk_path(oldest), ec);
+                if (ec) {
+                    last_error = "evict " + chunk_path(oldest) + ": " + ec.message();
+                }
+            }
+            evicted += 1;
+        }
+        return evicted;
+    }
+
+    // returns the files that could not be deleted
+    std::vector<std::string> clear() {
+        if (fh != nullptr) {
+            std::fclose(fh);
+            fh = nullptr;
+        }
+        fh_seq   = -1;
+        base_pos = 0;
+        end_pos  = 0;
+        chunks.clear();
+        fill.clear();
+        ranges.clear();
+        std::vector<std::string> failed;
+        if (disk && !dir.empty()) {
+            std::error_code ec;
+            for (const auto & de : fs::directory_iterator(dir, ec)) {
