+            { "chunks", (int64_t) store.chunks.size() },
+            { "bytes_disk", store.disk_bytes() },
+            { "bytes_mem", store.mem_bytes() + (int64_t) (keys.size() * 8 + pos.size() * 8) + short_bytes },
+            { "bytes_gpu", 0 },
+            { "cap_ids", cap_ids },
+            { "added_ids", added_ids },
+            { "deduped_ids", deduped_ids },
+            { "adds", adds },
+            { "evicted_chunks", evicted_chunks },
+            { "skipped_low_disk", skipped_low_disk },
+            { "add_blocked", add_blocked },
+            { "last_error", !last_error.empty() ? last_error : store.last_error },
+            { "evict_mode", "fifo" },
+            { "dedup_run", dedup_run },
+            { "short_hits", short_hits },
+            { "index_density", index_density },
+            { "index_slots", slots },
+            { "short_windows", [&] { json a = json::array(); for (const auto & t : shorts) a.push_back(t.w); return a; }() },
+        };
+    }
