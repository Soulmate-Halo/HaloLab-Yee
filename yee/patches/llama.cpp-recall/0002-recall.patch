+// _segments (core.py:280-292): True runs of keep, widened by overlap on both sides, [lo, hi)
+std::vector<std::pair<int64_t, int64_t>> rec_segments(const std::vector<char> & keep, int64_t overlap) {
+    std::vector<std::pair<int64_t, int64_t>> out;
+    const int64_t n = (int64_t) keep.size();
+    if (n == 0) {
+        return out;
+    }
+    if (std::all_of(keep.begin(), keep.end(), [](char v) { return v != 0; })) {
+        out.emplace_back(0, n);
+        return out;
+    }
+    int64_t i = 0;
+    while (i < n) {
+        if (keep[(size_t) i]) {
+            const int64_t s = i;
+            while (i < n && keep[(size_t) i]) {
+                ++i;
+            }
+            out.emplace_back(std::max<int64_t>(0, s - overlap), std::min<int64_t>(n, i + overlap));
+        } else {
+            ++i;
+        }
+    }
+    return out;
+}
