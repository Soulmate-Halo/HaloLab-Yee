+    std::vector<char> novel_mask(const std::vector<int64_t> & a) {
+        const int64_t na = (int64_t) a.size();
+        std::vector<char> keep((size_t) na, 1);
+        if (end() - base() < REC_WINDOW || na < REC_WINDOW) {
+            return keep;
+        }
+        const int64_t nw = na - REC_WINDOW + 1;
+        std::vector<int64_t> p((size_t) nw);
+        std::vector<char>    valid((size_t) nw, 0);
+        bool any = false;
+        uint64_t h = rec_hash(a.data(), REC_WINDOW);
+        for (int64_t i = 0; i < nw; ++i) {
+            if (i > 0) {
+                h = rec_roll(h, a[(size_t) i - 1], a[(size_t) (i + REC_WINDOW - 1)], pw1_long);
+            }
+            const size_t  s  = (size_t) (rec_mix(h) & (uint64_t) mask);
+            const int64_t pp = pos[s];
+            p[(size_t) i]     = pp;
+            valid[(size_t) i] = keys[s] == h && pp - REC_WINDOW >= base() && pp <= end();
+            any = any || valid[(size_t) i];
+        }
+        if (!any) {
+            return keep;
+        }
+        std::vector<char> chain((size_t) nw, 0);
+        for (int64_t i = 1; i < nw; ++i) {
+            chain[(size_t) i] = valid[(size_t) i] && valid[(size_t) i - 1] && p[(size_t) i] == p[(size_t) i - 1] + 1;
+        }
+        std::vector<int64_t> starts, ends;
+        for (int64_t i = 0; i < nw; ++i) {
+            const bool nxt = i + 1 < nw ? chain[(size_t) i + 1] != 0 : false;
+            if (valid[(size_t) i] && !chain[(size_t) i]) {
+                starts.push_back(i);
+            }
+            if (valid[(size_t) i] && !nxt) {
+                ends.push_back(i);
+            }
+        }
+        for (size_t q = 0; q < starts.size() && q < ends.size(); ++q) {
+            const int64_t s = starts[q], e = ends[q];
+            const int64_t cover = (e - s + 1) + (REC_WINDOW - 1);
+            const bool sel = na < 2 * REC_WINDOW ? cover >= REC_WINDOW : cover >= 2 * REC_WINDOW;
+            if (!sel) {
+                continue;
+            }
+            int64_t ts = 0, te = 0;
+            extend_run(a, s, e, p[(size_t) s], p[(size_t) e], ts, te);
+            if (te - ts >= dedup_run || (ts == 0 && te == na)) {
+                for (int64_t i = std::max<int64_t>(0, ts); i < std::min(te, na); ++i) {
+                    keep[(size_t) i] = 0;
+                }
+            }
+        }
+        return keep;
+    }
