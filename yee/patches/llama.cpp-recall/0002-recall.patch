+        }
+        if (rec->end() - rec->base() >= REC_WINDOW) {
+            const int64_t n  = (int64_t) st.ctx.size();
+            const int64_t t0 = std::max<int64_t>(0, n - REC_MAX_BACK);
+            std::vector<std::pair<int64_t, int>> hits;
+            rec->lookup_all(st.ctx.data() + t0, n - t0, REC_MAX_BACK, &st.h, hits);
+            for (const auto & hit : hits) {
+                rec_cand rc;
+                if (record_cont(hit.first, hit.second, n_tok, rc)) {
+                    out.push_back(std::move(rc));
+                }
+            }
+        }
+        for (auto & cand : out) {
+            bool dup = false;
+            for (auto & o : kept) {
+                const int m = std::min(cand.real, o.real);
+                if (std::equal(cand.toks.begin(), cand.toks.begin() + m, o.toks.begin())) {
+                    dup = true;
+                    if ((cand.real > o.real || (cand.real == o.real && cand.L > o.L)) && cand.src == o.src) {
+                        o = cand;
+                    }
+                    break;
+                }
+            }
+            if (!dup) {
+                kept.push_back(cand);
+            }
+            if ((int) kept.size() >= k) {
+                break;
+            }
+        }
+    }
+
+    // -------------------------------------------------------------- propose / propose_select (core.py:1982-2102)
+    common_recall_proposal propose(int slot, int n, double head_ema) {
+        common_recall_proposal res;
+        auto it = streams.find(slot);
+        if (it == streams.end() || (int64_t) it->second.ctx.size() < REC_WINDOW) {
+            return res;
+        }
+        rec_stream & st = it->second;
+        if (st.cooldown > 0) {
+            st.cooldown -= 1;
+            return res;
+        }
+        const int    n_tok = n <= 0 ? gamma : std::min(n, gamma);
+        const double own   = head_ema < 0 ? st.own_ema : head_ema;
+
+        std::unique_lock<std::mutex> lr(rmu, std::try_to_lock);
+        if (!lr.owns_lock()) {
+            lock_skips += 1; // a record write is running: no candidates this step (the inference thread never waits)
+            return res;
+        }
+        rec_cand best;
+        bool     have   = false;
+        double   best_e = -1.0;
+        if (tree) {
+            std::vector<rec_cand> cands;
+            candidates(st, n_tok, tree_k, cands);
+            int rec_n = 0;
+            for (const auto & c : cands) {
+                rec_n += c.src == 1 ? 1 : 0;
+            }
+            if (rec_n) {
+                lookups += 1;
+            }
+            if (rec_n > 1) {
+                tree_selects += 1;
+            }
+            for (auto & c : cands) {
+                const double e = expect(c.src, c.tier);
+                if (e > best_e || (have && e == best_e && c.src == 1 && best.src == 1 && c.L > best.L)) {
+                    best   = c;
+                    best_e = e;
+                    have   = true;
+                }
+            }
+        } else {
+            rec_cand c;
+            if (own_candidate(st, n_tok, c)) {
+                const double e = expect(c.src, c.tier);
+                if (e > best_e) {
+                    best = c, best_e = e, have = true;
+                }
+            }
+            if (record_candidate(st, n_tok, c)) {
+                const double e = expect(c.src, c.tier);
+                if (e > best_e) {
+                    best = c, best_e = e, have = true;
+                }
+            }
+        }
+        lr.unlock();
+        if (!have) {
+            return res;
+        }
+        bool probe = false;
+        if (best_e <= own) {
+            const int left = probe_left[best.src] - 1;
+            if (left > 0) {
+                probe_left[best.src] = left;
+                return res;
+            }
+            probe_left[best.src] = probe_iv[best.src];
+            probe = true;
+            probes += 1;
+        }
+        st.pending.push_back({ best.src, best.tier, probe, best.real, own, best.pos });
+        st.offers += 1;
+        st.last_seen = rec_now();
+        offers += 1;
+        offers_src[best.src] += 1;
+        offers_tier[best.tier] += 1;
+        res.tokens.reserve(best.toks.size());
+        for (int64_t t : best.toks) {
+            res.tokens.push_back((llama_token) t);
+        }
+        res.src       = best.src + 1;
+        res.tier      = best.tier;
+        res.match_len = best.L;
+        res.expect    = best_e;
+        res.real      = best.real;
+        res.probe     = probe;
+        return res;
+    }
+
+    void feedback(int slot, int landed, bool used) {
+        auto it = streams.find(slot);
+        if (it == streams.end() || it->second.pending.empty()) {
+            return;
+        }
+        rec_stream & st = it->second;
+        const rec_pending pd = st.pending.front();
+        st.pending.pop_front();
+        if (!used) {
+            unused += 1;
+            return;
+        }
+        used_n += 1;
+        landed = std::max(0, std::min(landed, pd.real));
+        rec_stat & s = stats[pd.src][pd.tier];
+        s.s = s.s * decay + (double) landed;
+        s.n = s.n * decay + 1.0;
+        s.offers += 1;
+        s.landed += landed;
+        landed_tokens += landed;
+        if (landed == 0) {
+            st.cooldown = cooldown_rounds;
+        }
+        if (pd.probe) {
+            if ((double) landed > pd.own) {
+                probe_iv[pd.src] = probe_start;
+            } else {
+                probe_iv[pd.src] = std::min(probe_iv[pd.src] * 2, probe_max);
+            }
+            probe_left[pd.src] = probe_iv[pd.src];
+        }
+    }
+
+    json stats_locked() {
+        json tiers = json::object();
+        for (int src = 0; src < 2; ++src) {
+            for (int t = 0; t < 4; ++t) {
+                const rec_stat & s = stats[src][t];
+                tiers[std::string(REC_SRC_NAMES[src]) + "_" + REC_TIER_NAMES[t]] = {
+                    { "offers", s.offers },
+                    { "landed", s.landed },
+                    { "rate", s.offers ? json(std::round(10000.0 * (double) s.landed / (double) s.offers) / 10000.0) : json(nullptr) },
+                    { "expect", std::round(10000.0 * expect(src, t)) / 10000.0 },
+                };
+            }
+        }
+        json d;
+        {
+            std::lock_guard<std::mutex> lr(rmu);
+            d = rec->stats();
+        }
+        d["base"]           = "llama.cpp";
+        d["enabled"]        = true;
+        d["gamma"]          = gamma;
+        d["tree"]           = tree;
+        d["tree_k"]         = tree_k;
+        d["min_match"]      = min_match;
+        d["offers"]         = offers;
+        d["proposals"]      = offers;
+        d["probes"]         = probes;
+        d["tree_selects"]   = tree_selects;
+        d["landed_tokens"]  = landed_tokens;
+        d["used"]           = used_n;
+        d["unused"]         = unused;
+        d["lookups"]        = lookups;
+        d["own_rounds"]     = rounds_own;
+        d["own_global_ema"] = std::round(10000.0 * own_global) / 10000.0;
+        d["active_streams"] = (int64_t) streams.size();
+        d["streams_begun"]  = streams_begun;
+        d["gc_streams"]     = gc_streams;
+        d["probe_interval"] = { { "own", probe_iv[0] }, { "record", probe_iv[1] } };
+        d["offers_by_src"]  = { { "own", offers_src[0] }, { "record", offers_src[1] } };
+        d["offers_by_tier"] = { { REC_TIER_NAMES[0], offers_tier[0] }, { REC_TIER_NAMES[1], offers_tier[1] },
+                                { REC_TIER_NAMES[2], offers_tier[2] }, { REC_TIER_NAMES[3], offers_tier[3] } };
+        d["tiers"]          = tiers;
+        d["ticks"]          = ticks;
+        d["lock_skips"]     = lock_skips;
+        d["errors"]         = errors.load();
+        d["last_clear"]     = last_clear;
+        d["time"]           = rec_utc_stamp();
+        return d;
+    }
+
+    void log_line(const json & d) {
+        LOG_INF("%s ticks=%lld streams=%lld proposals=%lld used=%lld landed=%lld src=own:%lld,record:%lld "
+                "tier=16-31:%lld,32-63:%lld,64+:%lld,<16:%lld store_ids=%lld records=%lld evicted=%lld errors=%lld\n",
+                tag_.c_str(), (long long) ticks, (long long) streams.size(), (long long) offers, (long long) used_n,
+                (long long) landed_tokens, (long long) offers_src[0], (long long) offers_src[1], (long long) offers_tier[0],
+                (long long) offers_tier[1], (long long) offers_tier[2], (long long) offers_tier[3],
+                (long long) d.value("ids", (int64_t) 0), (long long) d.value("adds", (int64_t) 0),
+                (long long) d.value("evicted_chunks", (int64_t) 0), (long long) errors.load());
+    }
+};
+
+// ------------------------------------------------------------------------------------------------ public API
+common_recall::common_recall(const common_recall_config & cfg_in) : p_(new impl()) {
+    impl & s = *p_;
+    try {
+        common_recall_config cfg = cfg_in;
+        common_recall_config_from_env(cfg);
+        s.gamma     = std::max(1, cfg.gamma);
+        s.min_match = std::max(REC_WINDOW, cfg.min_match);
+        s.prior     = rec_env_double("prior", 0.8) * (double) s.gamma;
+        s.own_global = 0.5 * (double) s.gamma;
+        s.tree      = rec_true(rec_tree_env("TREE", "1"));
+        int tk = 2;
+        try {
+            tk = std::max(0, std::min(3, (int) std::stod(rec_tree_env("TREE_K", "2"))));
+        } catch (...) {
+            tk = 2;
+        }
+        s.tree_k = std::max(1, tk) + 2;
+        s.sync   = rec_true(rec_getenv("YEE_RECALL_SYNC"));
+        s.log_s_ = cfg.log_s;
+        s.stats_file_ = !cfg.stats_file.empty() ? cfg.stats_file : rec_home() + "/.cache/yee/recall/recall_stats_llama.cpp.json";
+        s.stats_file_ = rec_expand(s.stats_file_);
+
+        int64_t chunk_ids = REC_CHUNK_IDS;
+        const std::string ck = rec_getenv("YEE_RECALL_CHUNK_IDS"); // test hook: small chunks to exercise eviction
+        if (!ck.empty()) {
+            try {
+                chunk_ids = std::stoll(ck);
+            } catch (...) {
+                chunk_ids = REC_CHUNK_IDS;
+            }
+        }
+        const bool   ro       = cfg.read_only == 1;
+        const double min_free = rec_env_double("min_free_gib", 4.0);
+        json ident = json::object();
+        if (!cfg.identity.empty()) {
+            ident["tokenizer_digest"] = cfg.identity;
+        }
+        ident["model"] = "llama.cpp";
+        const std::string want = rec_lower(rec_env("backend", ""));
+        const bool disk = !cfg.dir.empty() && want != "memory";
+        if (disk) {
+            try {
+                s.rec = std::make_unique<rec_record>("disk", cfg.dir, ident, cfg.gib, ro, min_free, chunk_ids);
+            } catch (const std::exception & e) {
+                // a record of another tokenizer (yee.core RecallIdentityError) or an unusable directory
+                s.error("record directory", std::string(e.what()) + "; the memory backend is used instead");
+                s.rec.reset();
+            }
+        }
+        if (!s.rec) {
+            s.rec = std::make_unique<rec_record>("memory", disk ? std::string() : cfg.dir, ident, cfg.gib, ro, min_free, chunk_ids);
+        }
+        s.backend_   = s.rec->backend;
+        s.dir_       = s.rec->backend == "disk" ? s.rec->dir : std::string();
+        s.read_only_ = !s.rec->writer;
+        s.last_log   = rec_now();
+        if (!s.sync) {
+            s.th = std::thread([this] { p_->writer_loop(); });
+        }
+        s.ok_ = true;
+        LOG_INF("%s record: backend=%s dir=%s writer=%d ids=%lld cap_ids=%lld index_slots=%lld short=%zu tree=%d k=%d stats=%s\n",
+                s.tag_.c_str(), s.backend_.c_str(), s.dir_.empty() ? "-" : s.dir_.c_str(), s.rec->writer ? 1 : 0,
+                (long long) (s.rec->end() - s.rec->base()), (long long) s.rec->cap_ids, (long long) s.rec->slots,
+                s.rec->shorts.size(), s.tree ? 1 : 0, s.tree_k, s.stats_file_.c_str());
+    } catch (const std::exception & e) {
+        s.error("init", e.what());
+        s.ok_ = false;
+    }
+}
+
+common_recall::~common_recall() {
+    if (!p_) {
+        return;
+    }
+    impl & s = *p_;
+    try {
+        if (s.th.joinable()) {
+            s.flush();
+            {
+                std::lock_guard<std::mutex> lk(s.qmu);
+                s.stop = true;
+            }
+            s.qcv.notify_all();
+            s.th.join();
+        }
+        if (s.rec) {
+            std::lock_guard<std::mutex> lr(s.rmu);
+            s.rec->store.flush();
+            s.rec->store.close();
+        }
+    } catch (...) {
+    }
+}
+
+bool common_recall::ok() const { return p_ && p_->ok_; }
+const std::string & common_recall::backend() const { return p_->backend_; }
+const std::string & common_recall::dir() const { return p_->dir_; }
+bool common_recall::read_only() const { return p_->read_only_; }
+int  common_recall::gamma() const { return p_->gamma; }
+
+void common_recall::begin_stream(int slot, const llama_token * prompt, size_t n_prompt, size_t cached_len) {
+    if (!ok()) {
+        return;
+    }
+    impl & s = *p_;
+    try {
+        std::vector<int64_t> p(prompt, prompt + n_prompt);
+        bool writer = false;
+        {
+            std::lock_guard<std::mutex> lk(s.mu);
+            rec_stream st;
+            st.own_ema = s.own_global;
+            const size_t nt = std::min<size_t>(64, p.size());
+            st.prompt_tail.assign(p.end() - (std::ptrdiff_t) nt, p.end());
+            const size_t nb = std::min<size_t>(REC_MAX_BACK, p.size());
+            st.append(p.data() + (p.size() - nb), nb, s.pw1);
+            st.last_seen = rec_now();
+            s.streams[slot] = std::move(st);
+            s.streams_begun += 1;
+            writer = s.rec->writer;
+        }
+        const size_t from = std::min(cached_len, p.size());
+        if (p.size() - from >= (size_t) REC_WINDOW && writer) {
+            rec_job job;
+            job.kind = 1;
+            job.ids.assign(p.begin() + (std::ptrdiff_t) from, p.end());
+            s.submit(std::move(job));
+        }
+    } catch (const std::exception & e) {
+        s.error("begin_stream", e.what());
+    }
+}
+
+void common_recall::extend_stream(int slot, const llama_token * toks, size_t n) {
+    if (!ok() || n == 0) {
+        return;
+    }
+    impl & s = *p_;
+    try {
+        std::lock_guard<std::mutex> lk(s.mu);
+        auto it = s.streams.find(slot);
+        if (it == s.streams.end()) {
+            return;
+        }
+        std::vector<int64_t> t(toks, toks + n);
+        it->second.append(t.data(), t.size(), s.pw1);
+        it->second.out_len += (int64_t) n;
+        it->second.last_seen = rec_now();
+    } catch (const std::exception & e) {
+        s.error("extend_stream", e.what());
+    }
+}
+
+void common_recall::end_stream(int slot, bool finished) {
+    if (!ok()) {
+        return;
+    }
+    impl & s = *p_;
+    try {
+        rec_job job;
+        {
+            std::lock_guard<std::mutex> lk(s.mu);
+            auto it = s.streams.find(slot);
+            if (it == s.streams.end()) {
+                return;
+            }
+            rec_stream st = std::move(it->second);
+            s.streams.erase(it);
+            if (!finished || !s.rec->writer || st.out_len <= 0) {
+                return;
+            }
+            const size_t no = (size_t) std::min<int64_t>(st.out_len, (int64_t) st.ctx.size());
+            job.ids = st.prompt_tail;
+            job.ids.insert(job.ids.end(), st.ctx.end() - (std::ptrdiff_t) no, st.ctx.end());
+        }
+        if (job.ids.size() >= (size_t) REC_WINDOW) {
+            job.kind = 1;
+            s.submit(std::move(job));
+        }
+    } catch (const std::exception & e) {
+        s.error("end_stream", e.what());
+    }
+}
+
+bool common_recall::has_stream(int slot) const {
+    if (!ok()) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lk(p_->mu);
+    return p_->streams.count(slot) > 0;
+}
+
+common_recall_proposal common_recall::propose(int slot, int n, double head_ema) {
+    if (!ok()) {
+        return {};
+    }
+    impl & s = *p_;
+    try {
+        std::lock_guard<std::mutex> lk(s.mu);
+        return s.propose(slot, n, head_ema);
+    } catch (const std::exception & e) {
+        s.error("propose", e.what());
+        return {};
+    }
+}
+
+void common_recall::feedback(int slot, int landed, bool used) {
+    if (!ok()) {
+        return;
+    }
+    impl & s = *p_;
+    try {
+        std::lock_guard<std::mutex> lk(s.mu);
+        s.feedback(slot, landed, used);
+    } catch (const std::exception & e) {
+        s.error("feedback", e.what());
+    }
+}
+
+void common_recall::observe_own(int slot, int accepted) {
+    if (!ok()) {
+        return;
+    }
+    impl & s = *p_;
+    try {
+        std::lock_guard<std::mutex> lk(s.mu);
+        const double a = s.own_alpha;
+        auto it = s.streams.find(slot);
+        if (it != s.streams.end()) {
+            it->second.own_ema = (1.0 - a) * it->second.own_ema + a * (double) accepted;
+        }
+        s.own_global = 0.99 * s.own_global + 0.01 * (double) accepted;
+        s.rounds_own += 1;
+    } catch (const std::exception & e) {
+        s.error("observe_own", e.what());
+    }
+}
+
+void common_recall::tick() {
+    if (!ok()) {
+        return;
+    }
+    impl & s = *p_;
+    const double now = rec_now();
+    if (now - s.last_tick < 2.0) {
+        return;
+    }
+    try {
+        bool want_clear = false;
+        bool writer     = false;
+        json d;
+        {
+            std::lock_guard<std::mutex> lk(s.mu);
+            s.last_tick = now;
+            s.ticks += 1;
+            {
+                std::lock_guard<std::mutex> lr(s.rmu);
+                want_clear = s.rec->poll_clear_request();
+                writer     = s.rec->writer;
+            }
+            if (want_clear && !writer) {
+                s.last_clear = "refused: read-only";
+            }
+            for (auto it = s.streams.begin(); it != s.streams.end();) {
+                if (now - it->second.last_seen > 600.0) {
+                    it = s.streams.erase(it);
+                    s.gc_streams += 1;
+                } else {
+                    ++it;
+                }
+            }
+            d = s.stats_locked();
+            if (s.log_s_ >= 0 && now - s.last_log >= s.log_s_) {
+                s.last_log = now;
+                s.log_line(d);
+            }
+        }
+        if (want_clear && writer) {
+            rec_job job;
+            job.kind = 2;
+            s.submit(std::move(job));
+        }
+        rec_job js;
+        js.kind = 3;
+        js.text = d.dump();
+        s.submit(std::move(js));
+    } catch (const std::exception & e) {
+        s.error("tick", e.what());
+    }
+}
+
+void common_recall::clear() {
+    if (!ok()) {
+        return;
+    }
+    impl & s = *p_;
+    try {
+        rec_job job;
+        job.kind = 2;
+        s.submit(std::move(job));
+        s.flush();
+    } catch (const std::exception & e) {
+        s.error("clear", e.what());
+    }
+}
+
+std::string common_recall::stats_json() {
+    if (!ok()) {
+        return "{\"base\":\"llama.cpp\",\"enabled\":false}";
+    }
+    impl & s = *p_;
+    try {
+        std::lock_guard<std::mutex> lk(s.mu);
+        return s.stats_locked().dump();
+    } catch (const std::exception & e) {
+        s.error("stats", e.what());
+        return "{}";
+    }
+}
+
+void common_recall::flush() {
+    if (!ok()) {
+        return;
+    }
+    p_->flush();
+}
