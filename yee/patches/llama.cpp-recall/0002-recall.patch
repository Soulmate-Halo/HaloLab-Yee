+    // ------------------------------------------------------------------ index (core.py:1193-1258)
+    void index_short(const std::vector<int64_t> & a, int64_t s0, int64_t g0, int64_t g1) {
+        for (auto & tab : shorts) {
+            const int     w   = tab.w;
+            const int64_t s0w = std::max(base(), g0 - (w - 1));
+            const int64_t off = s0w - s0;
+            if (off < 0 || off > (int64_t) a.size()) {
+                continue;
+            }
+            const int64_t asz  = (int64_t) a.size() - off;
+            const int64_t span = w + REC_MIN_TAIL;
+            const int64_t m    = std::min(asz - span + 1, g1 - w - s0w + 1);
+            if (m <= 0) {
+                continue;
+            }
+            const int64_t * aw = a.data() + off;
+            std::vector<int64_t> cs((size_t) asz + 1, 0);
+            for (int64_t i = 0; i < asz; ++i) {
+                cs[(size_t) i + 1] = cs[(size_t) i] + (aw[i] < 0 ? 1 : 0);
+            }
+            uint64_t h = rec_hash(aw, w);
+            for (int64_t j = 0; j < m; ++j) {
+                if (j > 0) {
+                    h = rec_roll(h, aw[j - 1], aw[j + w - 1], tab.pw1);
+                }
+                if (cs[(size_t) (j + span)] - cs[(size_t) j] != 0) {
+                    continue;
+                }
+                const size_t s = (size_t) (rec_mix(h) & (uint64_t) smask);
+                tab.k[s] = h;
+                tab.p[s] = s0w + j + w;
+            }
+        }
+    }
+
+    void index_range(int64_t g0, int64_t g1) {
+        const int64_t s0    = std::max(base(), g0 - (REC_WINDOW - 1));
+        const int64_t g_ext = std::min(end(), g1 + REC_MIN_TAIL);
+        if (g_ext - s0 < REC_WINDOW + REC_MIN_TAIL) {
+            return;
+        }
+        std::vector<int64_t> a;
+        if (!store.read(s0, g_ext, a)) {
+            return;
+        }
+        index_short(a, s0, g0, g1);
+        const int64_t span = REC_WINDOW + REC_MIN_TAIL;
+        const int64_t m    = std::min((int64_t) a.size() - span + 1, g1 - REC_WINDOW - s0 + 1);
+        if (m <= 0) {
+            return;
+        }
+        std::vector<int64_t> cs(a.size() + 1, 0);
+        for (size_t i = 0; i < a.size(); ++i) {
+            cs[i + 1] = cs[i] + (a[i] < 0 ? 1 : 0);
+        }
+        uint64_t h = rec_hash(a.data(), REC_WINDOW);
+        for (int64_t j = 0; j < m; ++j) {
+            if (j > 0) {
+                h = rec_roll(h, a[(size_t) j - 1], a[(size_t) (j + REC_WINDOW - 1)], pw1_long);
+            }
+            if (cs[(size_t) (j + span)] - cs[(size_t) j] != 0) {
+                continue;
+            }
+            const size_t s = (size_t) (rec_mix(h) & (uint64_t) mask);
+            keys[s] = h;
+            pos[s]  = s0 + j + REC_WINDOW;
+        }
+    }
+
+    void purge_index() {
