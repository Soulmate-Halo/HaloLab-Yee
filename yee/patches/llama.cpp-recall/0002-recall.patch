+    // _DiskStore._load (core.py:435-474)
+    void load() {
+        std::error_code ec;
+        if (!fs::is_directory(dir, ec)) {
+            return;
+        }
+        std::vector<int64_t> seqs;
+        for (const auto & de : fs::directory_iterator(dir, ec)) {
+            int64_t seq = 0;
+            if (rec_is_chunk_name(de.path().filename().string(), seq)) {
+                seqs.push_back(seq);
+            }
+        }
+        if (seqs.empty()) {
+            return;
+        }
+        std::sort(seqs.begin(), seqs.end());
+        std::vector<int64_t> run = { seqs.back() };
+        for (size_t i = seqs.size() - 1; i-- > 0;) {
+            if (seqs[i] != run.front() - 1) {
+                break;
+            }
+            run.insert(run.begin(), seqs[i]);
+        }
+        if (writer) {
+            for (int64_t s : seqs) {
+                if (s < run.front()) {
+                    std::error_code ec2;
+                    fs::remove(chunk_path(s), ec2);
+                }
+            }
+        }
+        for (int64_t s : run) {
+            const std::string path = chunk_path(s);
+            std::ifstream f(path, std::ios::binary);
+            std::string data((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+            const size_t usable = data.size() / 4 * 4;
+            if (usable != data.size() && writer) {
+                std::error_code ec2;
+                fs::resize_file(path, usable, ec2);
+            }
+            const size_t n = std::min<size_t>(usable / 4, (size_t) C);
+            std::vector<int32_t> buf((size_t) C, (int32_t) REC_SENTINEL);
+            std::memcpy(buf.data(), data.data(), n * 4);
+            chunks[s] = std::move(buf);
+            fill[s]   = (int64_t) n;
+        }
+        const int64_t last = run.back();
+        base_pos = run.front() * C;
+        end_pos  = last * C + fill[last];
+        if (writer) {
+            load_evicted = evict();
+        }
+        for (const auto & kv : chunks) {
+            const int64_t g0 = kv.first * C;
+            ranges.emplace_back(g0, kv.first == last ? g0 + fill[kv.first] : g0 + C);
+        }
+    }
