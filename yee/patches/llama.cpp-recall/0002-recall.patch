+#pragma once
+
+// Yee Recall for llama-server: cross-request copy drafts (C++ port of yee.core RecallRecord + RecallEngine).
+
+#include "llama.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+struct common_recall_config {
+    std::string dir;                // record directory; "" = memory backend (records live for the process only)
+    std::string identity;           // tokenizer identity (common_recall_vocab_identity); a disk record with another identity is refused
+    double      gib       = -1.0;   // capacity in GiB; < 0 = env / yee.core default
+    int         read_only = -1;     // -1 = env / default (off), 0 = off, 1 = on
+    int         gamma     = 12;     // longest proposal (launch K)
+    int         min_match = -1;     // < 0 = env / yee.core default
+    std::string stats_file;         // "" = $YEE_RECALL_STATS_FILE, else ~/.cache/yee/recall/recall_stats_llama.cpp.json
+    double      log_s     = -1.0;   // < 0 = $YEE_RECALL_LOG_S, else 30
+};
+
+// RECALL_ACCEL (or YEE_RECALL) is 1 / true / yes / on
+bool common_recall_env_enabled();
+
+// fill the fields that are still unset from the environment (names of yee.core ENV_NEW, e.g. RECALL_ACCEL_DIR)
+void common_recall_config_from_env(common_recall_config & cfg);
+
+// stable identity of a vocabulary: hex sha256 over n_vocab and every token piece
+std::string common_recall_vocab_identity(const struct llama_vocab * vocab);
+
+struct common_recall_proposal {
+    std::vector<llama_token> tokens;  // empty = no proposal
+    int    src       = 0;             // 0 none, 1 own context of the request, 2 record (cross-request)
+    int    tier      = -1;            // yee.core tier_of(match_len)
+    int    match_len = 0;
+    double expect    = 0.0;           // expected landed tokens
+    int    real      = 0;             // leading tokens copied from the source; the rest repeats the last one (yee.core Proposal.real)
+    bool   probe     = false;         // offered although expect <= the head's average (yee.core probe)
+};
