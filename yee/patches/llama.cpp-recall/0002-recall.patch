+        if (k > 0 && store.read(rs - k, rs, rec)) {
+            int64_t j = 0;
+            while (j < k && rec[(size_t) (k - 1 - j)] == a[(size_t) (ts - 1 - j)]) {
+                ++j;
+            }
+            ts -= j;
+        }
+        int64_t       te  = e + REC_WINDOW;
+        const int64_t re_ = p_e;
+        k = std::min<int64_t>({ 256, (int64_t) a.size() - te, end() - re_ });
+        if (k > 0 && store.read(re_, re_ + k, rec)) {
+            int64_t j = 0;
+            while (j < k && rec[(size_t) j] == a[(size_t) (te + j)]) {
+                ++j;
+            }
+            te += j;
+        }
+        ts_out = ts;
+        te_out = te;
+    }
