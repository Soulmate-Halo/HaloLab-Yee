+
+test "recall_after_priced: a priced proposer's none takes Recall's copy, its own drafts still stand as given" {
+    const p = prompt(40, 5);
+    const plain = try run(&.{.{ .prompt = &p, .drafts = false }}, null, .{});
+    defer plain.deinit();
+    var shared = try newShared();
+    defer shared.record.deinit();
+    try remember(&shared, &p, plain.emitted[0]);
+    var none: Stub = .{ .out = &.{}, .priced = true };
+    const recalled = try copyWithAfter(&none, &shared, &p, true);
+    defer gpa.free(recalled.tokens);
+    try std.testing.expect(recalled.recalled and recalled.tokens.len >= 2); // the none asks the record
+    try std.testing.expectEqualSlices(u32, plain.emitted[0][0..recalled.tokens.len], recalled.tokens); // the reply's own ids
+    var one: Stub = .{ .out = &.{plain.emitted[0][0]}, .priced = true };
+    const kept_one = try copyWithAfter(&one, &shared, &p, true);
+    defer gpa.free(kept_one.tokens);
+    try std.testing.expect(!kept_one.recalled); // a priced draft wins over the record
+    try std.testing.expectEqualSlices(u32, one.out, kept_one.tokens);
+    var empty = try newShared();
+    defer empty.record.deinit();
+    const nothing = try copyWithAfter(&none, &empty, &p, true);
+    defer gpa.free(nothing.tokens);
+    try std.testing.expect(!nothing.recalled and nothing.tokens.len == 0); // an empty record: the none stands
+}
+
+test "recall_after_priced in the round loop: a priced drafter's repeat copies from the record, same tokens greedy and sampled" {
+    const p = prompt(40, 7);
+    for ([_]?Sampling{ null, .{ .seed = 99, .temperature = 0.8 }, .{ .seed = 5, .temperature = 1.0, .top_k = 0, .top_p = 1.0 } }) |sampling| {
+        const plain = try run(&.{.{ .prompt = &p, .sampling = sampling, .drafts = false }}, null, .{});
+        defer plain.deinit();
+        var shared = try newShared();
+        defer shared.record.deinit();
+        try remember(&shared, &p, plain.emitted[0]);
+        const off = try run(&.{.{ .prompt = &p, .sampling = sampling }}, &shared, .{ .priced_none = true });
+        defer off.deinit();
+        try std.testing.expectEqualSlices(u32, plain.emitted[0], off.emitted[0]);
+        try std.testing.expectEqual(@as(u64, 0), off.proposals); // upstream: a priced none leaves the record alone
+        const on = try run(&.{.{ .prompt = &p, .sampling = sampling }}, &shared, .{ .priced_none = true, .after_priced = true });
+        defer on.deinit();
+        try std.testing.expectEqualSlices(u32, plain.emitted[0], on.emitted[0]);
+        try std.testing.expect(on.accepted > 0 and on.rounds < off.rounds);
+    }
+}
