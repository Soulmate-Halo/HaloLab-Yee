# 统一行尾：仓库内一律 LF，避免 Windows 检出/提交时行尾漂移
* text=auto eol=lf

# 明确为文本的文件
*.py     text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.txt    text eol=lf
*.cfg    text eol=lf
*.ini     text eol=lf
*.sh     text eol=lf
LICENSE   text eol=lf

# 二进制文件不做转换
*.whl    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.bin    binary
*.gz     binary
*.zip    binary
*.tgz    binary

# Patch payloads are sha256-pinned in yee/patches/MANIFEST.json: never convert line endings
yee/patches/** -text
*.patch -text
*.zig -text
